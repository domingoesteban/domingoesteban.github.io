---
// DEV ONLY: the new home page at /next/ while it is being built. Nothing is generated in a production build.
import HomePage from '@/components/home/HomePage.astro';
import { profile } from '@/data/profile';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { page: undefined } }] : [];
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{profile.name}</title>
  </head>
  <body style="margin:0">
    <HomePage />
  </body>
</html>
