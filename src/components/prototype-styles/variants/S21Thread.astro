  .index a { display: inline-flex; gap: 9px; padding: 6px 0; color: var(--body); transition: color .3s; }
  .index a span { color: var(--muted); }
  .index a:hover, .index a:hover span { color: var(--accent); }
  .stage { grid-column: 2; height: min(520px, 60vh); }

  /* sections */
  .block { padding-block: clamp(120px, 18vh, 200px); }
  .block h2 { margin: 20px 0 44px; font-size: clamp(30px, 3.3vw, 44px); line-height: 1.12; letter-spacing: -.028em; }

  .areas li { display: grid; grid-template-columns: 56px 1fr; padding: 30px 0; border-top: 1px solid var(--line); }
  .areas li:last-child { border-bottom: 1px solid var(--line); }
  .idx { font: 400 12px/1.9 var(--mono); color: var(--accent); }
  .areas h3 { font-size: 21px; line-height: 1.3; letter-spacing: -.015em; }
  .areas p { margin-top: 8px; font-size: 15.5px; }
  .areas .kw { margin-top: 14px; font: 400 11.5px/1.5 var(--mono); letter-spacing: .03em; color: var(--muted); }

  .lead { margin-bottom: 20px; font: 400 21px/1.55 var(--display); letter-spacing: -.008em; color: var(--ink); }
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 52px; padding-top: 22px; border-top: 1px solid var(--line); }
  .facts dt { font: 400 11px/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .facts dd { margin-top: 6px; font-size: 14.5px; color: var(--ink); }

  .job { display: grid; grid-template-columns: 120px 1fr; padding: 32px 0; border-top: 1px solid var(--line); }
  .job:last-child { border-bottom: 1px solid var(--line); }
  .period { font: 400 11.5px/2 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .job:first-child .period { color: var(--accent); }
  .job h3 { font-size: 20px; line-height: 1.35; letter-spacing: -.012em; }
  .org { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; margin-top: 4px; font-size: 15px; }
  .org a { color: var(--ink); background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 1px no-repeat; transition: color .3s, background-size .45s var(--ease); }
  .org a span { color: var(--accent); }
  .org a:hover { color: var(--accent); background-size: 100% 1px; }
  .place { font: 400 11px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .summary { margin-top: 10px; font-size: 15.5px; max-width: 48ch; }

  .notes li { display: grid; grid-template-columns: 120px 1fr; padding: 28px 0; border-top: 1px solid var(--line); }
  .notes li:last-child { border-bottom: 1px solid var(--line); }
  .notes time { font: 400 11.5px/2 var(--mono); letter-spacing: .04em; color: var(--muted); }
  .notes h3 { font-size: 19px; line-height: 1.35; letter-spacing: -.012em; }
  .notes p { margin-top: 6px; font-size: 15px; }
  .notes .tags { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 12px; }
  .tags span { font: 400 11px/1.4 var(--mono); letter-spacing: .03em; color: var(--muted); }
  .tags span::before { content: '#'; color: var(--accent); margin-right: 2px; }

  .contact { min-height: 72vh; }
  .contact h2 { font-size: clamp(40px, 5vw, 64px); letter-spacing: -.035em; margin-bottom: 18px; }
  .contact-lead { max-width: 40ch; }
  .links { display: flex; flex-wrap: wrap; gap: 0 36px; margin-top: 40px; }
  .links a { display: inline-flex; gap: 8px; padding: 10px 0; font: 500 18px/1.2 var(--display); color: var(--ink); border-bottom: 1px solid var(--line); transition: color .3s, border-color .3s; }
  .links a span { color: var(--accent); font-size: 14px; }
  .links a:hover { color: var(--accent); border-color: var(--accent); }

  .foot {
    grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    padding-top: 24px; border-top: 1px solid var(--line);
    font: 400 12px/1.5 var(--mono); letter-spacing: .03em; color: var(--muted);
  }

  /* reveals */
  .js [data-r] { opacity: 0; transform: translateY(10px); transition: opacity .9s var(--ease), transform .9s var(--ease); }
  .js [data-r].in { opacity: 1; transform: none; }

  @media (max-width: 859px) {
    .s21 { padding-bottom: 150px; }
    .dock {
      display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 4; height: 96px;
      background: var(--bg); border-top: 1px solid var(--line); opacity: 0; transition: background-color .4s;
    }
    .nav { flex-wrap: wrap; gap: 14px 16px; padding-top: 22px; padding-bottom: 18px; }
    .nav nav { order: 3; width: 100%; gap: 16px; }
    .nav nav a { font-size: 13.5px; }
    .wrap { grid-template-columns: minmax(0, 1fr); }
    .hero { min-height: 0; padding-block: 28px 24px; }
    .hero h1 { margin: 18px 0 22px; }
    .index { display: none; }
    .stage { grid-column: 1; height: min(34vh, 280px); margin-top: 20px; }
    .block { padding-block: 96px; }
    .block h2 { margin-bottom: 32px; }
    .areas li { grid-template-columns: 40px 1fr; }
    .job, .notes li { grid-template-columns: 1fr; gap: 4px; }
    .facts { grid-template-columns: 1fr 1fr; }
    .contact { min-height: 64vh; }
  }
  @media (prefers-reduced-motion: reduce) {
    .s21 *, .s21 *::before, .s21 *::after { transition: none !important; }
    .js [data-r] { opacity: 1; transform: none; }
  }
</style>
