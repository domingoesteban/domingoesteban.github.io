  .hud div { display: contents; }
  .hud dt { text-transform: uppercase; letter-spacing: .08em; }
  .hud dd { color: var(--ink); }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) 230px; gap: clamp(40px, 6vw, 96px); margin-top: clamp(48px, 8vh, 96px); }
  .rail { position: relative; }
  .companion { position: sticky; top: 22vh; opacity: 0; transition: opacity 1s cubic-bezier(.2, .7, .2, 1); }
  .rail.on .companion { opacity: 1; }
  .mini { display: block; width: 100%; height: 340px; }
  .cap { display: flex; justify-content: space-between; gap: 8px; padding-top: 12px; border-top: 1px solid var(--line); font: 400 11px/1.4 var(--mono); color: var(--muted); white-space: nowrap; }
  .cap span:first-child { color: var(--blue); }

  .sec { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 32px; padding: 30px 0 clamp(96px, 14vh, 150px); border-top: 1px solid var(--line); }
