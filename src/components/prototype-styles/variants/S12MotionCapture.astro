  .lead { font: 500 clamp(22px, 2.3vw, 32px)/1.36 var(--head); letter-spacing: -.02em; max-width: 34ch; }
  .about-foot { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 48px; margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--line); }
