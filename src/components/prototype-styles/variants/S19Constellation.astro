  }
  @media (max-width: 859px) {
    .wrap { padding: 0 20px; }
    .nav { height: 56px; }
    .nav nav { display: none; }
    .hero, .sec, .sec.flip { grid-template-columns: minmax(0, 1fr); }
    .sec.flip > .txt { grid-column: 1; }
    .hero { min-height: 0; padding: 44px 0 0; align-items: start; }
    .hero .slot { height: min(38vh, calc(100vw - 40px)); margin-top: 36px; }
    .sec .slot { display: none; }
    .sec { padding: 120px 0 40px; }
    .contact { padding-bottom: 150px; }
    .kicker { margin-bottom: 20px; }
    .tagline { margin-top: 24px; }
    .head { margin-bottom: 36px; }
    .areas li { grid-template-columns: 40px minmax(0, 1fr); }
    .jobs li, .notes a { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .facts { grid-template-columns: minmax(0, 1fr); }
    .facts div, .facts div + div { padding: 14px 0; border-left: 0; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; }
    .facts dd { margin: 0; }
    .links a { font-size: 19px; grid-template-columns: minmax(0, 1fr) 20px; }
    .links .mono { display: none; }
    .foot { margin-top: 72px; }
    .dock { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .s19.js [data-r] { opacity: 1; transform: none; transition: none; }
  }
</style>
