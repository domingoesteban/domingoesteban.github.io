    --accent: #2f5ce6;
    --node: #273142;
    --sans: 'Inter', system-ui, sans-serif;
    --display: 'Inter Tight', 'Inter', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    background: var(--bg);
    color: var(--body);
    min-height: 100vh;
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
    transition: background-color 0.4s, color 0.4s;
  }
  .s19[data-theme="dark"] {
    --bg: #0c111b;
    --panel: #111827;
    --ink: #e2e6ee;
    --body: #a1aab9;
    --muted: #6d788b;
    --line: #1f2939;
    --accent: #7ea3ff;
    --node: #d3dae6;
  }
  .s19 *, .s19 *::before, .s19 *::after { box-sizing: border-box; }
  .s19 a { color: inherit; text-decoration: none; }
  :where(.s19) :where(h1, h2, h3, p, ol, ul, dl, dd) { margin: 0; padding: 0; }
  :where(.s19) :where(ol, ul) { list-style: none; }
  .mono { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.02em; line-height: 1.5; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 48px; }

  .nav { position: sticky; top: 0; z-index: 10; height: 64px; background: var(--bg); border-bottom: 1px solid var(--line); transition: background-color 0.4s, border-color 0.4s; }
  .nav-in { height: 100%; display: flex; align-items: center; gap: 28px; }
  .brand { font-family: var(--display); font-weight: 500; font-size: 15px; color: var(--ink); letter-spacing: -0.01em; margin-right: auto; }
  .nav nav { display: flex; gap: 26px; font-size: 14px; }
  .nav nav a { color: var(--body); transition: color 0.2s; }
  .nav nav a:hover { color: var(--accent); }
  .theme { width: 32px; height: 32px; border: 1px solid var(--line); border-radius: 50%; background: none; color: var(--body); display: grid; place-items: center; cursor: pointer; padding: 0; transition: border-color 0.2s, color 0.2s; }
  .theme:hover { border-color: var(--accent); color: var(--accent); }
  .theme svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .theme .moon { display: none; }
  .s19[data-theme="dark"] .theme .sun { display: none; }
  .s19[data-theme="dark"] .theme .moon { display: block; }

  .hero, .sec { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 72px; }
  .sec.flip { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .sec.flip > .txt { grid-column: 2; grid-row: 1; }
  .sec.flip > .slot { grid-column: 1; grid-row: 1; }
  .hero { min-height: calc(100vh - 64px); align-items: center; padding: 40px 0; }
  .hero .slot { align-self: stretch; }

  .kicker { display: flex; align-items: center; gap: 10px; color: var(--muted); margin-bottom: 28px; }
  .kicker i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  h1 { font-family: var(--display); font-weight: 300; font-size: clamp(54px, 6.4vw, 92px); line-height: 0.98; letter-spacing: -0.042em; color: var(--ink); }
  .tagline { margin-top: 34px; max-width: 30ch; font-family: var(--display); font-weight: 300; font-size: clamp(21px, 2vw, 27px); line-height: 1.38; letter-spacing: -0.012em; color: var(--ink); }
  .tagline em { font-style: normal; color: var(--accent); }
  .role { margin-top: 22px; font-size: 15.5px; color: var(--body); }
