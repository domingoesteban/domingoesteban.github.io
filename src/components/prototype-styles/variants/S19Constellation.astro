  h2 { margin-top: 26px; font-family: var(--display); font-weight: 300; font-size: clamp(34px, 3.6vw, 48px); line-height: 1.08; letter-spacing: -0.03em; color: var(--ink); max-width: 18ch; }
  h3 { font-family: var(--display); font-weight: 400; font-size: 21px; line-height: 1.3; letter-spacing: -0.012em; color: var(--ink); }
  .kw { color: var(--muted); margin-top: 14px; white-space: pre-wrap; }

  .areas li { display: grid; grid-template-columns: 56px minmax(0, 1fr); padding: 30px 0; border-top: 1px solid var(--line); }
  .areas li:last-child { border-bottom: 1px solid var(--line); }
  .areas .n { color: var(--accent); padding-top: 5px; }
  .areas p:not(.kw) { margin-top: 10px; max-width: 58ch; }

  .lead { font-family: var(--display); font-weight: 300; font-size: 23px; line-height: 1.48; letter-spacing: -0.01em; color: var(--ink); margin-bottom: 24px; }
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 48px; border-top: 1px solid var(--line); }
  .facts div { padding: 18px 16px 0 0; }
  .facts div + div { padding-left: 18px; border-left: 1px solid var(--line); }
