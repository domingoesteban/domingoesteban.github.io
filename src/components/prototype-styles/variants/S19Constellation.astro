  .facts dd { margin-top: 6px; color: var(--ink); font-size: 15px; }

  .jobs li { display: grid; grid-template-columns: 112px minmax(0, 1fr); padding: 34px 0; border-top: 1px solid var(--line); }
  .jobs li:last-child { border-bottom: 1px solid var(--line); }
  .when { color: var(--accent); padding-top: 5px; }
  .org { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; margin: 6px 0 12px; font-size: 15px; }
  .org a { color: var(--ink); border-bottom: 1px solid var(--line); transition: color 0.2s, border-color 0.2s; }
  .org a:hover { color: var(--accent); border-color: var(--accent); }
  .org .mono { color: var(--muted); }

  .notes li { border-top: 1px solid var(--line); }
  .notes li:last-child { border-bottom: 1px solid var(--line); }
  .notes a { display: grid; grid-template-columns: 112px minmax(0, 1fr); padding: 28px 0; }
  .notes time { color: var(--muted); padding-top: 5px; }
  .notes p:not(.kw) { margin-top: 8px; }
  .notes a h3 { transition: color 0.2s; }
  .notes a:hover h3 { color: var(--accent); }

  .contact { padding-bottom: 80px; }
  .links li { border-top: 1px solid var(--line); }
  .links li:last-child { border-bottom: 1px solid var(--line); }
  .links a { display: grid; grid-template-columns: minmax(0, 1fr) auto 28px; align-items: baseline; gap: 16px; padding: 20px 0; font-family: var(--display); font-size: 22px; font-weight: 300; color: var(--ink); }
  .links .mono { color: var(--muted); }
  .links .arr { color: var(--muted); text-align: right; transition: color 0.2s, transform 0.2s; }
  .links a:hover .arr { color: var(--accent); transform: translate(2px, -2px); }
  .foot { display: flex; justify-content: space-between; margin-top: 120px; color: var(--muted); }
  .foot a:hover { color: var(--accent); }

  .stage { position: fixed; left: 0; top: 0; z-index: 3; width: 0; height: 0; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); pointer-events: none; transition: background-color 0.4s, border-color 0.4s; }
  .cap { position: absolute; left: 14px; bottom: 10px; color: var(--muted); opacity: var(--cap, 1); }
  .sky { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 4; pointer-events: none; }
  .dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 2; height: 96px; background: var(--bg); border-top: 1px solid var(--line); opacity: 0; pointer-events: none; display: none; align-items: center; padding: 0 16px; }
  .dock-label { color: var(--muted); white-space: pre; }

  .s19.js [data-r] { opacity: 0; transform: translateY(12px); transition: opacity 0.9s cubic-bezier(.2,.7,.2,1), transform 0.9s cubic-bezier(.2,.7,.2,1); }
  .s19.js [data-r].in { opacity: 1; transform: none; }

  @media (max-width: 1080px) {
    .wrap { padding: 0 32px; }
    .hero, .sec { column-gap: 40px; }
