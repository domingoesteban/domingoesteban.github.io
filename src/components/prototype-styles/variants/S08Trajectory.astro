---
// PROTOTYPE 08 Trajectory: a planned path that draws itself down the page as you scroll.
import { profile, areas, experience, notes, formatDate } from '../content';

// Waypoint x (percent of width on desktop) and the side the content sits on.
const wp = (i: number, x: number) => ({ x, label: `x ${(x / 100).toFixed(2)}  y ${(i * 1.6).toFixed(2)}  t ${i}.0` });
const route = [
  { id: 's08-about', name: 'About' },
  { id: 's08-research', name: 'Research' },
  { id: 's08-work', name: 'Experience' },
  { id: 's08-notes', name: 'Notes' },
  { id: 's08-contact', name: 'Contact' },
];
const jobs = experience.map((e, i) => ({ ...e, side: i % 2 ? 'right' : 'left', wp: wp(3 + i, i % 2 ? 34 : 66) }));
---
<div class="s08">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@200;300;400;500&family=Inter:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" />

  <header class="nav">
    <a class="brand" href="#s08-top">{profile.name}</a>
    <nav aria-label="Primary">
      <a href="#s08-research">Research</a>
      <a href="#s08-about">About</a>
      <a href="#s08-work">Work</a>
      <a href="#s08-notes">Notes</a>
      <a href="#s08-contact">Contact</a>
    </nav>
  </header>

  <main class="course" id="s08-top">
    <svg class="track" aria-hidden="true">
      <defs>
        <linearGradient id="s08-ink" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#3366ff" />
          <stop offset=".55" stop-color="#4f8bff" />
          <stop offset="1" stop-color="#3fc6ec" />
        </linearGradient>
        <filter id="s08-glow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="6" /></filter>
      </defs>
      <g class="ghosts" data-ghosts></g>
      <path class="plan" data-plan d="" />
      <path class="done" data-done d="" />
      <g class="robot" data-dot>
        <circle class="halo" r="16" filter="url(#s08-glow)" />
        <circle class="ring" r="9" />
        <circle class="core" r="4.5" />
        <text class="readout" x="16" y="-12" data-readout></text>
      </g>
    </svg>

    <section class="hero" aria-labelledby="s08-name">
      <span class="wp start" data-wp style="--x:80%"><span class="wp-label">start  x 0.80  y 0.00  t 0.0</span></span>
      <div class="hero-text">
        <p class="eyebrow">{profile.location} · <span>47.37° N, 8.54° E</span></p>
        <h1 id="s08-name"><span>{profile.firstName}</span> <span class="last">{profile.lastName}</span></h1>
        <p class="role">{profile.role} at <a href={experience[0].href} target="_blank" rel="noopener">{profile.company}</a></p>
        <p class="tagline">{profile.tagline}</p>
        <ol class="plan-list" aria-label="Sections">
          {route.map((r, i) => <li><a href={`#${r.id}`}><span>0{i + 1}</span>{r.name}</a></li>)}
        </ol>
      </div>
    </section>

    <section class="block left" id="s08-about" aria-labelledby="s08-about-h">
      <span class="wp" data-wp style="--x:70%"><span class="wp-label">{wp(1, 70).label}</span></span>
      <div class="content">
        <p class="eyebrow"><span class="n">WP 01</span>About</p>
        <h2 id="s08-about-h">Learning to move, one rollout at a time.</h2>
        <p class="lead">{profile.bio[0]}</p>
        <p>{profile.bio[1]}</p>
      </div>
    </section>

    <section class="block right" id="s08-research" aria-labelledby="s08-research-h">
      <span class="wp" data-wp style="--x:30%"><span class="wp-label">{wp(2, 30).label}</span></span>
      <div class="content">
        <p class="eyebrow"><span class="n">WP 02</span>Research</p>
        <h2 id="s08-research-h">Three directions</h2>
        <ol class="areas">
          {areas.map((a, i) => (
            <li>
              <span class="idx">R.0{i + 1}</span>
              <h3>{a.title}</h3>
              <p>{a.summary}</p>
              <p class="kw">{a.keywords.join('  /  ')}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {jobs.map((j, i) => (
      <section class={`block ${j.side} job`} id={i === 0 ? 's08-work' : undefined} aria-labelledby={`s08-job-${i}`}>
        <span class="wp" data-wp style={`--x:${j.wp.x}%`}><span class="wp-label">{j.wp.label}</span></span>
        <div class="content">
          {i === 0 && <p class="eyebrow"><span class="n">WP 03</span>Experience</p>}
          {i === 0 && <h2>Where the path has been</h2>}
          <p class="t">t = {i} <span>{j.period}</span></p>
          <h3 id={`s08-job-${i}`}>{j.title}</h3>
          <p class="org"><a href={j.href} target="_blank" rel="noopener">{j.org}<span aria-hidden="true"> ↗</span></a><span class="place">{j.place}</span></p>
          <p class="summary">{j.summary}</p>
        </div>
      </section>
    ))}

    <section class="block right" id="s08-notes" aria-labelledby="s08-notes-h">
      <span class="wp" data-wp style="--x:30%"><span class="wp-label">{wp(6, 30).label}</span></span>
      <div class="content">
        <p class="eyebrow"><span class="n">WP 04</span>Notes</p>
        <h2 id="s08-notes-h">Notes along the way</h2>
        <ul class="notes">
          {notes.map(n => (
            <li>
              <time datetime={n.date.toISOString()}>{formatDate(n.date)}</time>
              <div>
                <h3>{n.title}</h3>
                <p>{n.description}</p>
                {n.tags && <p class="tags">{n.tags.map(t => <span>{t}</span>)}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="goal" id="s08-contact" aria-labelledby="s08-contact-h">
      <span class="wp end" data-wp style="--x:50%"><span class="wp-label">goal  x 0.50  y 11.20  t 7.0</span></span>
      <div class="content">
        <p class="eyebrow"><span class="n">WP 05</span>Contact</p>
        <h2 id="s08-contact-h">Let's talk.</h2>
        <ul class="links">
          {profile.links.map(l => <li><a href={l.href} target="_blank" rel="noopener">{l.label}<span aria-hidden="true"> ↗</span></a></li>)}
        </ul>
      </div>
    </section>
  </main>

  <footer class="footer">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span>{profile.location} · From {profile.origin}</span>
  </footer>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.s08');
  if (root) {
    root.classList.add('js');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const course = root.querySelector<HTMLElement>('.course')!;
    const svg = root.querySelector<SVGSVGElement>('.track')!;
    const plan = svg.querySelector<SVGPathElement>('[data-plan]')!;
    const done = svg.querySelector<SVGPathElement>('[data-done]')!;
    const ghosts = svg.querySelector<SVGGElement>('[data-ghosts]')!;
    const dot = svg.querySelector<SVGGElement>('[data-dot]')!;
    const readout = svg.querySelector<SVGTextElement>('[data-readout]')!;
    const markers = [...root.querySelectorAll<HTMLElement>('[data-wp]')];
    const NS = 'http://www.w3.org/2000/svg';

    type P = { x: number; y: number };
    let samples: (P & { l: number })[] = [];
    let markerL: number[] = [];
    let total = 0, width = 1, current = 0, target = 0, raf = 0;

    const cubic = (s: number, [a, b, c, d]: P[]) => {
      const u = 1 - s;
      return {
        x: u * u * u * a.x + 3 * u * u * s * b.x + 3 * u * s * s * c.x + s * s * s * d.x,
        y: u * u * u * a.y + 3 * u * u * s * b.y + 3 * u * s * s * c.y + s * s * s * d.y,
      };
    };

    const lengthAtY = (y: number) => {
      if (!samples.length) return 0;
      let lo = 0, hi = samples.length - 1;
      if (y <= samples[0].y) return 0;
      if (y >= samples[hi].y) return total;
      while (hi - lo > 1) {
        const mid = (lo + hi) >> 1;
        if (samples[mid].y < y) lo = mid; else hi = mid;
      }
      const a = samples[lo], b = samples[hi];
      return a.l + ((y - a.y) / (b.y - a.y || 1)) * (b.l - a.l);
    };

    const pointAt = (l: number): P => {
      const i = Math.min(samples.length - 1, Math.max(0, Math.round(l / 6)));
      return samples[i] ?? { x: 0, y: 0 };
    };

    // Noisy ghost rollouts that branch at the start and converge back onto the plan.
    const drawGhosts = (seg: P[]) => {
      ghosts.replaceChildren();
      const amp = Math.min(72, width * 0.05);
      for (let r = 0; r < 7; r++) {
        const sign = r % 2 ? 1 : -1;
        const a = amp * (0.35 + (r / 6) * 0.8) * sign;
        let d = '';
        for (let k = 0; k <= 60; k++) {
          const s = (k / 60) * 0.62;
          const p = cubic(s, seg);
          const q = cubic(Math.min(1, s + 0.002), seg);
          const len = Math.hypot(q.x - p.x, q.y - p.y) || 1;
          const nx = -(q.y - p.y) / len, ny = (q.x - p.x) / len;
          const env = Math.sin(Math.PI * (k / 60)) ** 1.4;
          const off = a * env * (0.75 + 0.25 * Math.sin(9 * s + r * 1.7)) + 4 * env * Math.sin(31 * s + r * 2.3);
          d += `${k ? 'L' : 'M'}${(p.x + nx * off).toFixed(1)} ${(p.y + ny * off).toFixed(1)}`;
        }
        const path = document.createElementNS(NS, 'path');
        path.setAttribute('d', d);
        path.setAttribute('class', r % 3 === 0 ? 'ghost cyan' : 'ghost');
        path.style.animationDelay = `${-r * 0.9}s`;
        ghosts.append(path);
      }
    };

    const render = (l: number) => {
      done.style.strokeDashoffset = `${total - l}`;
      const p = pointAt(l);
      dot.setAttribute('transform', `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`);
      let i = 0;
      while (i < markerL.length - 2 && l > markerL[i + 1]) i++;
      const span = markerL[i + 1] - markerL[i] || 1;
      const t = i + Math.min(1, Math.max(0, (l - markerL[i]) / span));
      readout.textContent = `x ${(p.x / width).toFixed(3)}  y ${(t * 1.6).toFixed(2)}  t ${t.toFixed(2)}`;
      markers.forEach((m, i) => m.classList.toggle('reached', l >= markerL[i] - 2));
    };

    const measureTarget = () => {
      const y = innerHeight * 0.58 - course.getBoundingClientRect().top;
      target = lengthAtY(y);
    };

    const step = () => {
      current += (target - current) * 0.09;
      if (Math.abs(target - current) < 0.4) current = target;
      render(current);
      raf = current === target ? 0 : requestAnimationFrame(step);
    };

    const onScroll = () => {
      if (reduce) return;
      measureTarget();
      if (!raf) raf = requestAnimationFrame(step);
    };

    const build = () => {
      const box = course.getBoundingClientRect();
      width = course.clientWidth;
      const height = course.offsetHeight;
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('width', `${width}`);
      svg.setAttribute('height', `${height}`);

      const pts = markers.map(m => {
        const r = m.getBoundingClientRect();
        return { x: r.left + r.width / 2 - box.left, y: r.top + r.height / 2 - box.top };
      });
      const segs: P[][] = [];
      let d = `M${pts[0].x.toFixed(1)} ${pts[0].y.toFixed(1)}`;
      for (let i = 1; i < pts.length; i++) {
        const a = pts[i - 1], b = pts[i];
        const k = (b.y - a.y) * 0.5;
        const seg = [a, { x: a.x, y: a.y + k }, { x: b.x, y: b.y - k }, b];
        segs.push(seg);
        d += ` C${seg[1].x.toFixed(1)} ${seg[1].y.toFixed(1)} ${seg[2].x.toFixed(1)} ${seg[2].y.toFixed(1)} ${b.x.toFixed(1)} ${b.y.toFixed(1)}`;
      }
      plan.setAttribute('d', d);
      done.setAttribute('d', d);
      total = done.getTotalLength();
      done.style.strokeDasharray = `${total} ${total}`;
      samples = [];
      for (let l = 0; l <= total; l += 6) {
        const p = done.getPointAtLength(l);
        samples.push({ x: p.x, y: p.y, l });
      }
      markerL = pts.map(p => lengthAtY(p.y));
      if (segs[0]) drawGhosts(segs[0]);

      if (reduce) {
        current = target = total;
        render(total);
        dot.style.display = 'none';
      } else {
        measureTarget();
        current = target;
        render(current);
      }
      root.classList.add('ready');
    };

    let pending = 0;
    const schedule = () => {
      cancelAnimationFrame(pending);
      pending = requestAnimationFrame(build);
    };
    new ResizeObserver(schedule).observe(course);
    document.fonts?.ready.then(schedule);
    addEventListener('scroll', onScroll, { passive: true });

    // Ghost dashes only flow while the hero is on screen.
    const hero = root.querySelector('.hero');
    if (hero) {
      new IntersectionObserver(([e]) => root.classList.toggle('hero-off', !e.isIntersecting)).observe(hero);
    }

    const reveal = new IntersectionObserver(entries => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('in');
        reveal.unobserve(e.target);
      }
    }, { rootMargin: '0px 0px -10% 0px' });
    root.querySelectorAll('.content, .hero-text').forEach(el => reveal.observe(el));
  }
</script>

<style>
  .s08 {
    --ink: #101828;
    --ink-2: #475467;
    --ink-3: #8b95a7;
    --line: #e7eaf0;
    --blue: #3366ff;
    --cyan: #3fc6ec;
    --cyan-soft: #e6f8fd;
    --gutter: clamp(16px, 4vw, 48px);
    --display: 'Sora', system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    position: relative;
    background: #fff;
    color: var(--ink);
    font: 400 16px/1.65 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
    padding-bottom: 88px;
  }
  .s08 *, .s08 *::before, .s08 *::after { box-sizing: border-box; }
  :where(.s08 h1, .s08 h2, .s08 h3, .s08 p, .s08 ol, .s08 ul) { margin: 0; padding: 0; }
  :where(.s08 ol, .s08 ul) { list-style: none; }
  :where(.s08 a) { color: inherit; text-decoration: none; }
  .s08 a:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; border-radius: 4px; }

  .nav {
    position: relative; z-index: 3;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    max-width: 1240px; margin: 0 auto; padding: 28px var(--gutter);
  }
  .brand { font: 500 15px/1 var(--display); letter-spacing: -.01em; }
  .nav nav { display: flex; gap: clamp(14px, 2.4vw, 34px); }
  .nav nav a { font-size: 14px; color: var(--ink-2); position: relative; transition: color .3s; }
  .nav nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1px; background: var(--blue); transform: scaleX(0); transform-origin: left; transition: transform .45s cubic-bezier(.2, .7, .2, 1); }
  .nav nav a:hover { color: var(--ink); }
  .nav nav a:hover::after { transform: scaleX(1); }

  .course { position: relative; max-width: 1240px; margin: 0 auto; padding: 0 var(--gutter); }
  .track { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: visible; }
  .plan { fill: none; stroke: #c9d5f5; stroke-width: 1.4; stroke-dasharray: 1 7; stroke-linecap: round; }
  .done { fill: none; stroke: url(#s08-ink); stroke-width: 2.2; stroke-linecap: round; }
  .s08 :global(.ghost) { fill: none; stroke: var(--blue); stroke-width: 1.2; stroke-dasharray: 4 6; opacity: .3; animation: s08-flow 7s linear infinite; }
  .s08 :global(.ghost.cyan) { stroke: #1fb3df; opacity: .5; }
  .hero-off :global(.ghost) { animation-play-state: paused; }
  @keyframes s08-flow { to { stroke-dashoffset: -100; } }
  .robot { opacity: 0; transition: opacity .6s; }
  .ready .robot { opacity: 1; }
  .halo { fill: var(--blue); opacity: .35; }
  .ring { fill: none; stroke: var(--blue); stroke-width: 1; opacity: .4; transform-box: fill-box; transform-origin: center; animation: s08-ping 2.8s cubic-bezier(.2, .7, .2, 1) infinite; }
  @keyframes s08-ping { from { transform: scale(.6); opacity: .7; } to { transform: scale(2.2); opacity: 0; } }
  .core { fill: #fff; stroke: var(--blue); stroke-width: 2.5; }
  .readout { font: 500 10px var(--mono); fill: var(--blue); letter-spacing: .04em; }

  /* waypoints */
  .wp {
    position: absolute; z-index: 2; left: var(--x); top: 50%;
    width: 13px; height: 13px; margin: -6.5px 0 0 -6.5px; border-radius: 50%;
    background: #fff; border: 1.5px solid #b8c6ef;
    transition: background .5s, border-color .5s, box-shadow .5s;
  }
  .wp.reached { border-color: var(--blue); background: var(--blue); box-shadow: 0 0 0 6px rgb(51 102 255 / .1); }
  .wp-label {
    position: absolute; top: 50%; left: 22px; transform: translateY(-50%);
    font: 400 11px/1 var(--mono); letter-spacing: .04em; color: var(--ink-3); white-space: pre;
    transition: color .5s;
  }
  .wp.reached .wp-label { color: var(--blue); }
  .right .wp-label { left: auto; right: 22px; }
  .start { top: 36%; }
  .end { top: 0; width: 18px; height: 18px; margin: -9px 0 0 -9px; }
  .end::before, .end::after { content: ''; position: absolute; border-radius: 50%; border: 1px solid #c9d5f5; inset: -12px; }
  .end::after { inset: -26px; border-style: dashed; }
  .end .wp-label { left: 48px; }

  /* hero */
  .hero { position: relative; z-index: 1; min-height: clamp(600px, 88vh, 880px); display: flex; align-items: center; }
  .hero-text { max-width: 760px; padding: 40px 0 80px; }
  .eyebrow { display: flex; align-items: center; gap: 12px; font: 400 12px/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .eyebrow .n { color: var(--blue); }
  .hero h1 { margin: 26px 0 34px; font: 200 clamp(56px, 10vw, 152px)/.92 var(--display); letter-spacing: -.055em; }
  .hero h1 span { display: block; }
  .hero h1 .last { color: var(--blue); font-weight: 300; padding-left: .5em; }
  .role { font-size: 16px; color: var(--ink-2); }
  .role a { color: var(--ink); border-bottom: 1px solid var(--line); transition: border-color .3s, color .3s; }
  .role a:hover { color: var(--blue); border-color: var(--blue); }
  .tagline { margin-top: 14px; max-width: 28ch; font: 300 clamp(21px, 2.3vw, 30px)/1.35 var(--display); letter-spacing: -.02em; }
  .plan-list { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 48px; font: 400 12px/1 var(--mono); letter-spacing: .04em; }
  .plan-list a { display: inline-flex; gap: 8px; padding: 6px 0; color: var(--ink-2); transition: color .3s; }
  .plan-list a span { color: var(--blue); }
  .plan-list li + li::before { content: '→'; color: #c4ccda; margin-right: 22px; }
  .plan-list li { display: inline-flex; align-items: center; }
  .plan-list a:hover { color: var(--blue); }

  /* blocks */
  .block {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px;
    padding-block: clamp(80px, 11vw, 150px);
  }
  .block.left .content { grid-column: 1 / 6; }
  .block.right .content { grid-column: 8 / 13; }
  .job { padding-block: clamp(56px, 7vw, 96px); }
  .content h2 { margin: 18px 0 28px; font: 300 clamp(32px, 3.8vw, 50px)/1.08 var(--display); letter-spacing: -.035em; }
  .lead { font: 300 21px/1.5 var(--display); letter-spacing: -.01em; margin-bottom: 18px; }
  .content > p:not(.eyebrow):not(.lead) { color: var(--ink-2); }

  .areas li { padding: 26px 0; border-top: 1px solid var(--line); }
  .areas li:last-child { border-bottom: 1px solid var(--line); }
  .idx, .t { font: 400 11px/1 var(--mono); letter-spacing: .08em; color: var(--blue); }
  .areas h3 { margin: 12px 0 8px; font: 400 22px/1.25 var(--display); letter-spacing: -.02em; }
  .areas p { font-size: 15px; color: var(--ink-2); }
  .areas .kw { margin-top: 12px; font: 400 11.5px/1.5 var(--mono); color: var(--ink-3); letter-spacing: .02em; }

  .t { display: flex; align-items: center; gap: 10px; }
  .t span { text-transform: uppercase; }
  .t span { padding: 4px 9px; border-radius: 999px; background: var(--cyan-soft); color: #0d7fa3; letter-spacing: .06em; }
  .job h3 { margin: 18px 0 8px; font: 400 clamp(24px, 2.4vw, 30px)/1.2 var(--display); letter-spacing: -.025em; }
  .org { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; font-weight: 500; }
  .org a { color: var(--blue); background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size .45s cubic-bezier(.2, .7, .2, 1); }
  .org a:hover { background-size: 100% 1px; }
  .place { font: 400 12px/1 var(--mono); color: var(--ink-3); letter-spacing: .06em; text-transform: uppercase; }
  .job .summary { margin-top: 14px; color: var(--ink-2); max-width: 46ch; }

  .notes li { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 22px 0; border-top: 1px solid var(--line); }
  .notes li:last-child { border-bottom: 1px solid var(--line); }
  .notes time { font: 400 12px/1.9 var(--mono); color: var(--ink-3); letter-spacing: .02em; }
  .notes h3 { font: 400 19px/1.3 var(--display); letter-spacing: -.015em; }
  .notes p { margin-top: 6px; font-size: 14.5px; color: var(--ink-2); }
