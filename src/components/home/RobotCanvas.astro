---
// The robot: one fixed canvas over the page (hero grid, then the follower beside the sections) and, on mobile,
// a dock at the bottom where the follower walks. All logic is in src/lib/robot (start with its README).
---
<canvas class="view" aria-hidden="true"></canvas>
<div class="dock" aria-hidden="true">
  <span class="dock-cap mono"></span>
  <div class="dock-fig"></div>
  <span class="dock-bar"><i></i></span>
</div>

<script>
  import { startRobot } from '@/lib/robot/app';

  const root = document.querySelector<HTMLElement>('.home');
  if (root) startRobot(root);
</script>

<style>
  .view { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 3; pointer-events: none; }
  .dock { display: none; }

  @media (max-width: 900px) {
    .dock {
      display: block; position: fixed; z-index: 2; pointer-events: none; left: 12px; right: 12px; bottom: 12px; height: 92px;
      border: 1px solid var(--line-2); border-radius: 14px; background: var(--bg); overflow: hidden; opacity: var(--c, 0);
    }
    .dock-cap { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 10px; }
    .dock-fig { position: absolute; top: 0; bottom: 0; right: 4%; width: 52%; }
    .dock-bar { position: absolute; left: 18px; right: 18px; bottom: 0; height: 1px; background: var(--line); }
    .dock-bar i { position: absolute; inset: 0; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  }
</style>
