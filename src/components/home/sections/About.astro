---
import { Content as Bio } from '../../../content/about.md';
import Section from '../Section.astro';
---
<Section id="about" heading="Real work takes the *whole* body.">
  <!-- The first paragraph of about.md is the lead. -->
  <div class="bio" data-r-each><Bio /></div>
</Section>

<style>
  .bio :global(p:first-child) { font-size: var(--fs-lead); line-height: 1.52; letter-spacing: -.01em; color: var(--ink-2); }
  .bio :global(p + p) { margin-top: 22px; line-height: 1.68; }
</style>
