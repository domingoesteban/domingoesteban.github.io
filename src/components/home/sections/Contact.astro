---
import { profile } from '@/data/profile';
import Section from '../Section.astro';

const host = (href: string) => href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<Section id="contact" heading="Say hello.">
  <p class="body" data-r>For research, collaborations or a conversation about robot learning.</p>
  <ul class="links">
    {profile.links.map(l => (
      <li data-r>
        <a href={l.href} target="_blank" rel="noopener">
          <span class="l-name">{l.label}</span>
          <span class="l-host mono">{host(l.href)}</span>
          <span class="l-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>
</Section>

<style>
  .body { margin-top: 22px; line-height: 1.68; }
  .links { margin-top: 32px; border-top: 1px solid var(--line-2); }
  .links a { display: grid; grid-template-columns: minmax(0, 1fr) auto 24px; align-items: baseline; gap: 20px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .l-name { font-size: var(--fs-lead); font-weight: 500; letter-spacing: -.02em; color: var(--ink-2); transition: color .2s; }
  .l-host { color: var(--muted); text-transform: none; letter-spacing: .02em; }
  .l-arrow { color: var(--muted); text-align: right; transition: color .2s, transform .3s var(--ease); }
  .links a:hover .l-name, .links a:hover .l-arrow { color: var(--accent); }
  .links a:hover .l-arrow { transform: translate(2px, -2px); }

  @media (max-width: 900px) {
    .links a { grid-template-columns: minmax(0, 1fr) 20px; }
    .l-host { display: none; }
  }
</style>
