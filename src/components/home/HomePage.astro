---
// The home page: hero, then the sections of PAGE (src/data/page.ts) in its order, with a transition band
// between each pair where the robot walks. Section "about-me" is rendered from sections/AboutMe.astro.
import './home.css';
import Nav from './Nav.astro';
import RobotCanvas from './RobotCanvas.astro';
import Hero from './Hero.astro';
import Footer from './Footer.astro';
import { SECTIONS } from '@/lib/robot/story';

const files = import.meta.glob<{ default: any }>('./sections/*.astro', { eager: true });
const file = (id: string) => `./sections/${id.split('-').map(w => w[0].toUpperCase() + w.slice(1)).join('')}.astro`;
const sections = SECTIONS.map(s => {
  const f = files[file(s.id)];
  if (!f) throw new Error(`Section "${s.id}" in src/data/page.ts has no component ${file(s.id).slice(2)}`);
  return f.default;
});
---
<div class="home">
  <Nav />
  <RobotCanvas />
  <Hero />
  <main class="wrap">
    {sections.map((Part, i) => (
      <>
        {i > 0 && <div class="band" aria-hidden="true"></div>}
        <Part />
      </>
    ))}
  </main>
  <Footer />
</div>

<script>
  // Reveal [data-r] elements (and each child of [data-r-each]) as they scroll into view.
  const root = document.querySelector<HTMLElement>('.home');
  if (root) {
    root.classList.add('js');
    const reveal = new IntersectionObserver(entries => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); reveal.unobserve(e.target); }
    }, { rootMargin: '0px 0px -6% 0px' });
    root.querySelectorAll('[data-r], [data-r-each] > *').forEach(el => reveal.observe(el));
  }
</script>

<style>
  /* Desktop band heights are set by the robot (src/lib/robot/app.ts) so a walk fits in view. */
  .band { height: 80vh; }
  @media (max-width: 900px) {
    .band { height: 28vh; }
  }
</style>
