---
import { profile } from '@/data/profile';
---
<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="wrap hero-in">
    <div class="hero-text" data-r>
      <p class="kicker mono">{profile.field} <span aria-hidden="true">/</span> {profile.location}</p>
      <h1 id="hero-name">{profile.firstName}<br />{profile.lastName}</h1>
      <p class="role">{profile.role}, {profile.focus}</p>
      <p class="tagline">{profile.tagline}</p>
      <ul class="hero-links mono">
        {[...profile.links, profile.scholar].map(l => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
      </ul>
    </div>
    <!-- The robot canvas draws the hero tiles inside this box. -->
    <div class="stage" aria-hidden="true"></div>
  </div>
</section>

<style>
  .hero-in {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--colgap); align-items: center;
    min-height: calc(100vh - var(--nav)); padding-block: clamp(32px, 6vh, 72px);
  }
  .kicker { color: var(--muted); margin-bottom: 28px; }
  .kicker span { color: var(--line-2); margin-inline: 6px; }
  h1 { font-weight: 400; font-size: var(--fs-h1); line-height: .98; letter-spacing: -.04em; color: var(--ink); }
  .role { margin-top: 30px; font-size: var(--fs-large); color: var(--body); text-wrap: balance; }
  .tagline { margin-top: 12px; font-size: var(--fs-lead); text-wrap: balance; line-height: 1.5; max-width: 30ch; color: var(--body); }
  .hero-links { display: flex; gap: 22px; margin-top: 36px; }
  .hero-links a { color: var(--muted); transition: color .2s; }
  .hero-links a:hover { color: var(--accent); }
  .stage { height: min(500px, 58vh); width: 100%; }
  @media (min-width: 2000px) { .stage { height: min(720px, 58vh); } }

  @media (max-width: 900px) {
    /* As tall as its content: a full-screen hero leaves a gap between the text and the grid on tall screens. */
    .hero-in { grid-template-columns: 1fr; row-gap: 20px; min-height: 0; padding-block: 36px 16px; }
    .kicker { margin-bottom: 18px; }
    .role { margin-top: 22px; font-size: 16px; }
    .hero-links { margin-top: 22px; }
    .stage { height: min(38vh, 320px); }
  }
</style>
